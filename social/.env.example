# Only for isolated local development. Change the public example password before shared use.
COMPOSE_PROJECT_NAME=steamscope-social-dev
POSTGRES_USER=steamscope_social
POSTGRES_PASSWORD=local_only_change_me
POSTGRES_DB=steamscope_social_dev
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=56379
API_HOST_PORT=8100
FRONTEND_HOST_PORT=3100
SOCIAL_ENVIRONMENT=development
SOCIAL_DATABASE_URL=postgresql+asyncpg://steamscope_social:local_only_change_me@127.0.0.1:55433/steamscope_social_dev
SOCIAL_REDIS_URL=redis://127.0.0.1:56379/0
SOCIAL_CORS_ORIGINS=["http://127.0.0.1:3100"]
SOCIAL_BROWSER_ORIGIN=http://127.0.0.1:3100
SOCIAL_COOKIE_SECURE=false
SOCIAL_SESSION_ABSOLUTE_SECONDS=604800
SOCIAL_SESSION_IDLE_SECONDS=86400
SOCIAL_RECENT_AUTH_SECONDS=600
SOCIAL_LOGIN_ATTEMPT_SECONDS=300
SOCIAL_PROVIDER_TIMEOUT_SECONDS=5
SOCIAL_AUTH_RATE_LIMIT=10
SOCIAL_SENSITIVE_RATE_LIMIT=30
SOCIAL_DEPENDENCY_TIMEOUT_SECONDS=2
SOCIAL_WORKER_CHECK_INTERVAL_SECONDS=10
# Server-side frontend setting for native execution. Compose overrides with its internal origin.
INTERNAL_API_URL=http://127.0.0.1:8100
NEXT_TELEMETRY_DISABLED=1
BROWSER_ORIGIN=http://127.0.0.1:3100
# Callback: http://127.0.0.1:3100/api/v1/auth/steam/callback
# Steam OpenID login needs no Web API key. Optional data sync needs your private key.
# Obtain it manually at https://steamcommunity.com/dev/apikey while signed in to Steam.
# Save only in ignored social/.env; never commit it or send it to frontend variables.
# Standard user Web API key; project owner enters privately. API capability + worker only.
# Runtime only: never NEXT_PUBLIC, build arg, job payload, database or browser.
# Empty disables sync without breaking OpenID or health. Do not copy legacy credentials.
SOCIAL_STEAM_API_KEY=
SOCIAL_STEAM_SYNC_LEASE_SECONDS=90
SOCIAL_STEAM_SYNC_MAX_ATTEMPTS=3
SOCIAL_STEAM_SYNC_COOLDOWN_SECONDS=300
SOCIAL_STEAM_REQUESTS_PER_MINUTE=30
SOCIAL_STEAM_REQUESTS_PER_DAY=1000
SOCIAL_STEAM_USER_REQUESTS_PER_HOUR=12

# Shared English achievement schema cache (application policy, not Steam update frequency).
SOCIAL_STEAM_SCHEMA_TTL_SECONDS=86400
